<Application
    x:Class="AlchemyStars.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia"
    RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <DataTemplate DataType="local:LocalizedOption" x:DataType="local:LocalizedOption">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />

    <Style Selector=":is(Control).accessible-focus">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderThickness="2" BorderBrush="{DynamicResource AlchemyFocusBrush}" CornerRadius="3" IsHitTestVisible="False" />
        </Template>
      </Setter>
    </Style>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="SF Pro Text, Inter, Segoe UI, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource AlchemyBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>
    <!-- Popup roots do not always inherit the owning Window's typography. Keep
         menus and tooltips on the same bilingual UI family as the workspace. -->
    <Style Selector="MenuItem, ToolTip">
      <Setter Property="FontFamily" Value="SF Pro Text, Inter, Segoe UI, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyPressedBrush}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Width" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.panel-command">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Width" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.panel-command.compact-preview-command">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Width" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.panel-command.preview-transport-command">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Width" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ToggleButton.preview-command">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Width" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.preview-command:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.preview-command:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyPressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.preview-command:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ToggleButton.preview-command:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.preview-command:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="ToggleButton.preview-command.compact-preview-command">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Width" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.activity">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity.selected">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.activity.selected Path.icon-glyph.muted">
      <Setter Property="Stroke" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyErrorBrush}" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.dock-panel">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.dock-header">
      <Setter Property="Height" Value="44" />
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.workspace-panel">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
    </Style>
    <Style Selector="Border.composition-canvas">
      <Setter Property="Background" Value="{DynamicResource AlchemyCanvasBrush}" />
    </Style>

    <Style Selector="Border.inspector-section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.editor-card">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.subcard">
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="Border.dropzone">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.dropzone:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
    </Style>
    <Style Selector="Border.hero-card">
      <Setter Property="Background" Value="{DynamicResource AlchemyHeroBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.dialog-card">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.count-badge">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.feature-icon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.preview-badge">
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Border.preview-badge.compact-preview-badge">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Slider.preview-scrubber">
      <Setter Property="Background" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Slider.preview-scrubber:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox:pointerover, ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox:focus-within, ComboBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,0,0,8" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dock-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.rail-label">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>

    <Style Selector="Path.icon-glyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AlchemyTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.icon-glyph.preview-icon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="StrokeThickness" Value="1.65" />
    </Style>
    <Style Selector="Path.icon-glyph.transport-icon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="StrokeThickness" Value="1.7" />
    </Style>
    <Style Selector="Path.icon-glyph.muted"><Setter Property="Stroke" Value="{DynamicResource AlchemyMutedTextBrush}" /></Style>
    <Style Selector="Path.icon-glyph.on-accent"><Setter Property="Stroke" Value="#FFFFFFFF" /></Style>
    <Style Selector="Path.icon-glyph.accent"><Setter Property="Stroke" Value="{DynamicResource AlchemyAccentBrush}" /></Style>
    <Style Selector="Path.icon-glyph.danger-glyph"><Setter Property="Stroke" Value="{DynamicResource AlchemyErrorBrush}" /></Style>

    <Style Selector="Expander.property-group">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,0,14,14" />
    </Style>
    <!-- Keep inspector fields clear of the vertical scrollbar, including their right border. -->
    <Style Selector="ScrollViewer.inspector-scroll">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="Expander.property-group /template/ ToggleButton">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.canvas-footer">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.track-heading">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,5" />
    </Style>
    <Style Selector="Border.track-heading TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="Border.track-row">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="ContentControl.clip">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Grid.track-lane">
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.clip-frame-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.82" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ContentControl.base-clip">
      <Setter Property="Background" Value="{DynamicResource AlchemyBaseClipBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBaseEdgeBrush}" />
    </Style>
    <Style Selector="ContentControl.layer-clip">
      <Setter Property="Background" Value="{DynamicResource AlchemyLayerClipBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyLayerEdgeBrush}" />
    </Style>
    <Style Selector="ListBox.asset-list, ListBox.track-list">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.asset-list ListBoxItem, ListBox.track-list ListBoxItem">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ListBox.track-list ListBoxItem">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="GridSplitter:pointerover, GridSplitter:focus-visible">
      <Setter Property="Background" Value="{DynamicResource AlchemyFocusBrush}" />
    </Style>

    <!-- Shared dimensions are logical pixels, so form rows remain aligned at any DPI.
         Preview transport controls intentionally retain their compact 32/40 px sizes. -->
    <Style Selector="Button, TextBox, ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="ToggleButton"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="TextBox"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="ComboBox"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <!-- Multiline editors must be free to grow rather than clipping their content. -->
    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!-- Long inspector paths stay readable: the field keeps normal editing behaviour, but while it is
         not focused the tail of the path is shown with a leading ellipsis, matching the asset lists.
         Only the presenter is hidden so every theme keeps its own field chrome; the overlay is
         hit-test transparent, so clicks, focus and drag/drop still reach the TextBox underneath.
         The 13 DIP margin matches the shared 1 DIP border plus 12 DIP field padding. -->
    <Style Selector="Panel.path-field TextBox /template/ TextPresenter">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Panel.path-field:focus-within TextBox /template/ TextPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.path-display">
      <Setter Property="Margin" Value="13,0,13,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style Selector="Panel.path-field:focus-within TextBlock.path-display">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.path-field:disabled TextBlock.path-display">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter, ListBoxItem /template/ ContentPresenter, MenuItem /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="Button.secondary, Button.primary">
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter, Button.icon /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter, Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement, ComboBox /template/ Border#Background">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.card, Border.subcard, Border.hero-card, Border.dialog-card">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.workspace-panel">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.activity.selected, Button.panel-command, ToggleButton.preview-command">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.asset-list ListBoxItem, ListBox.track-list ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="4,2" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="Button.toolbar /template/ ContentPresenter, Button.panel-command /template/ ContentPresenter, Button.activity /template/ ContentPresenter, Button.subtle /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.activity.selected /template/ ContentPresenter, ToggleButton.preview-command:checked /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="ListBox, ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>
    <Style Selector="Border.dock-header">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.composition-canvas">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <!-- Apple utility grammar; preserve the existing workspace geometry. -->
    <Style Selector="Button, MenuItem, ToolTip, TextBox, ComboBox, CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource AppearanceControlFontSize}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Button:pressed, ToggleButton.preview-command:pressed">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button.primary, Button.secondary">
      <Setter Property="CornerRadius" Value="9999" />
      <Setter Property="FontWeight" Value="{DynamicResource AppearanceActionFontWeight}" />
      <Setter Property="FontSize" Value="{DynamicResource AppearanceActionFontSize}" />
      <Setter Property="Padding" Value="22,8" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="CornerRadius" Value="9999" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyChipBrush}" />
    </Style>
    <Style Selector="Border.card, Border.subcard, Border.dialog-card">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="Padding" Value="{DynamicResource AppearanceCardPadding}" />
    </Style>
    <Style Selector="Border.workspace-panel, Border.composition-canvas, Border.hero-card">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBlock.command-text">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.command-text.muted">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyOnDarkMutedBrush}" />
    </Style>
    <Style Selector="Border.command-bar Path.icon-glyph">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Border.command-bar Button.toolbar:pointerover /template/ ContentPresenter, Border.command-bar Button.toolbar:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyDarkTileBrush}" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="LetterSpacing" Value="-0.374" />
    </Style>
    <Style Selector="TextBlock.body-copy">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="LineHeight" Value="25" />
      <Setter Property="LetterSpacing" Value="-0.374" />
    </Style>
    <Style Selector="TextBlock.display-title">
      <Setter Property="FontFamily" Value="SF Pro Display, Inter, Segoe UI, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.28" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement, ComboBox:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="Button.activity.selected /template/ ContentPresenter, ToggleButton.preview-command:checked /template/ ContentPresenter">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
    </Style>
    <!-- Shared icon frames preserve the existing 44/40/32 px hit targets. -->
    <Style Selector="Image.product-icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|ThemedIcon">
      <Setter Property="UseDesktopGlyph" Value="{DynamicResource AppearanceUseDesktopIcons}" />
      <Setter Property="UseWindowsXpGlyph" Value="{DynamicResource AppearanceUseWindowsXpIcons}" />
      <Setter Property="UseWindows2000Glyph" Value="{DynamicResource AppearanceUseWindows2000Icons}" />
      <Setter Property="CustomIconRevision" Value="{DynamicResource CustomIconRevision}" />
      <Setter Property="UseClassicGlyph" Value="{DynamicResource AppearanceUseClassicIcons}" />
      <Setter Property="IconBrush" Value="{DynamicResource AlchemyIconBrush}" />
    </Style>
    <Style Selector="local|ThemedIcon.product-icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.activity Image.product-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Button.activity local|ThemedIcon.product-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="IconBrush" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="Button.activity.selected local|ThemedIcon.product-icon, Border.feature-icon local|ThemedIcon.product-icon">
      <Setter Property="IconBrush" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Border.command-bar local|ThemedIcon.product-icon">
      <Setter Property="IconBrush" Value="{DynamicResource AlchemyCommandTextBrush}" />
    </Style>
    <Style Selector="Button.primary local|ThemedIcon.product-icon">
      <Setter Property="IconBrush" Value="White" />
    </Style>
    <Style Selector="Border.feature-icon">
      <Setter Property="Padding" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.feature-icon Image.product-icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Border.feature-icon local|ThemedIcon.product-icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Path.icon-glyph, Path.icon-glyph.muted">
      <Setter Property="Stroke" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Border.command-bar Path.icon-glyph">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <StyleInclude Source="avares://AlchemyStars.Avalonia/Themes/Appearance.axaml" />
    <StyleInclude Source="avares://AlchemyStars.Avalonia/Themes/DesktopShell.axaml" />
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="AlchemyChipBrush" Color="#d2d2d7" />
    <SolidColorBrush x:Key="AlchemyIconBrush" Color="#0066cc" />
    <SolidColorBrush x:Key="AlchemyOnDarkMutedBrush" Color="#cccccc" />
    <SolidColorBrush x:Key="AlchemyDarkTileBrush" Color="#272729" />
    <Color x:Key="SystemAccentColor">#0066cc</Color>
    <Color x:Key="SystemAccentColorDark1">#0066cc</Color>
    <Color x:Key="SystemAccentColorLight1">#0071e3</Color>
    <x:Boolean x:Key="AppearanceUseDesktopIcons">False</x:Boolean>
    <x:Boolean x:Key="AppearanceUseClassicIcons">False</x:Boolean>
    <x:Boolean x:Key="AppearanceUseWindowsXpIcons">False</x:Boolean>
    <x:Boolean x:Key="AppearanceUseWindows2000Icons">False</x:Boolean>
    <x:Double x:Key="AppearanceControlFontSize">14</x:Double>
    <x:Double x:Key="AppearanceActionFontSize">17</x:Double>
    <FontWeight x:Key="AppearanceActionFontWeight">Normal</FontWeight>
    <Thickness x:Key="AppearanceCardPadding">24</Thickness>
    <!-- DESIGN-apple.md: neutral surfaces and a single Action Blue accent. -->
    <Color x:Key="AlchemyBackground">#f5f5f7</Color>
    <Color x:Key="AlchemySidebar">#f5f5f7</Color>
    <Color x:Key="AlchemyCommandBar">#000000</Color>
    <Color x:Key="AlchemyCanvas">#f5f5f7</Color>
    <Color x:Key="AlchemySurface">#ffffff</Color>
    <Color x:Key="AlchemySubtleSurface">#fafafc</Color>
    <Color x:Key="AlchemySurfaceRaised">#fafafc</Color>
    <Color x:Key="AlchemyBorder">#f0f0f0</Color>
    <Color x:Key="AlchemyBorderStrong">#e0e0e0</Color>
    <Color x:Key="AlchemyAccent">#0066cc</Color>
    <Color x:Key="AlchemyFocus">#0071e3</Color>
    <Color x:Key="AlchemyText">#1d1d1f</Color>
    <Color x:Key="AlchemyMutedText">#7a7a7a</Color>
    <SolidColorBrush x:Key="AlchemyBackgroundBrush" Color="{StaticResource AlchemyBackground}" />
    <SolidColorBrush x:Key="AlchemySidebarBrush" Color="{StaticResource AlchemySidebar}" />
    <SolidColorBrush x:Key="AlchemyCommandBarBrush" Color="{StaticResource AlchemyCommandBar}" />
    <SolidColorBrush x:Key="AlchemyCanvasBrush" Color="{StaticResource AlchemyCanvas}" />
    <SolidColorBrush x:Key="AlchemySurfaceBrush" Color="{StaticResource AlchemySurface}" />
    <SolidColorBrush x:Key="AlchemySubtleSurfaceBrush" Color="{StaticResource AlchemySubtleSurface}" />
    <SolidColorBrush x:Key="AlchemySurfaceRaisedBrush" Color="{StaticResource AlchemySurfaceRaised}" />
    <SolidColorBrush x:Key="AlchemyBorderBrush" Color="{StaticResource AlchemyBorder}" />
    <SolidColorBrush x:Key="AlchemyBorderStrongBrush" Color="{StaticResource AlchemyBorderStrong}" />
    <SolidColorBrush x:Key="AlchemyAccentBrush" Color="{StaticResource AlchemyAccent}" />
    <SolidColorBrush x:Key="AlchemyFocusBrush" Color="{StaticResource AlchemyFocus}" />
    <SolidColorBrush x:Key="AlchemyTextBrush" Color="{StaticResource AlchemyText}" />
    <SolidColorBrush x:Key="AlchemyMutedTextBrush" Color="{StaticResource AlchemyMutedText}" />
    <SolidColorBrush x:Key="AlchemyHoverBrush" Color="#f5f5f7" />
    <SolidColorBrush x:Key="AlchemyPressedBrush" Color="#f0f0f0" />
    <SolidColorBrush x:Key="AlchemySelectedBrush" Color="#f5f5f7" />
    <SolidColorBrush x:Key="AlchemyAccentHoverBrush" Color="#0066cc" />
    <SolidColorBrush x:Key="AlchemyAccentBorderBrush" Color="#0071e3" />
    <SolidColorBrush x:Key="AlchemyHeroBrush" Color="#f5f5f7" />
    <SolidColorBrush x:Key="AlchemySuccessBrush" Color="#7a7a7a" />
    <SolidColorBrush x:Key="AlchemyErrorBrush" Color="#FFB83D50" />
    <SolidColorBrush x:Key="AlchemyBaseClipBrush" Color="#f5f5f7" />
    <SolidColorBrush x:Key="AlchemyBaseEdgeBrush" Color="#0066cc" />
    <SolidColorBrush x:Key="AlchemyLayerClipBrush" Color="#fafafc" />
    <SolidColorBrush x:Key="AlchemyLayerEdgeBrush" Color="#7a7a7a" />
  </Application.Resources>
</Application>
