<Window
    x:Class="AlchemyStars.Avalonia.MainWindow"
    x:Name="Root"
    x:DataType="local:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia"
    xmlns:engine="using:AlchemyStars.Engine"
    Title="{Binding WindowTitle}"
    Icon="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.ico"
    Width="1460"
    Height="900"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    KeyDown="WindowKeyDown"
    AutomationProperties.Name="{Binding WindowTitle}">

  <Grid ColumnDefinitions="48,*" RowDefinitions="48,*,24">
    <Border Grid.Row="1" Background="{DynamicResource AlchemySidebarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="2">
        <StackPanel Spacing="4">
          <Button Classes="activity" Click="AnimationsPageClick" ToolTip.Tip="{Binding Text.Animations}" AutomationProperties.Name="{Binding Text.Animations}" Classes.selected="{Binding IsAnimationsPage}"><Path Classes="icon-glyph " Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7 M8,11 L13,14 L8,17 Z" IsHitTestVisible="False" /></Button>
          <Button Classes="activity" Click="PartsPageClick" ToolTip.Tip="{Binding Text.ModelParts}" AutomationProperties.Name="{Binding Text.ModelParts}" Classes.selected="{Binding IsModelPartsPage}"><Path Classes="icon-glyph " Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
          <Button Classes="activity" Click="SettingsPageClick" ToolTip.Tip="{Binding Text.Settings}" AutomationProperties.Name="{Binding Text.Settings}" Classes.selected="{Binding IsSettingsPage}"><Path Classes="icon-glyph " Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /></Button>
          <Button Classes="activity" Click="AboutPageClick" ToolTip.Tip="{Binding Text.About}" AutomationProperties.Name="{Binding Text.About}" Classes.selected="{Binding IsAboutPage}"><Path Classes="icon-glyph " Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M10,9 L10,15 M10,6 L10,7" IsHitTestVisible="False" /></Button>
          <Button Classes="activity" Click="LanguageClick" AutomationProperties.Name="{Binding LanguageButtonAccessibleName}" ToolTip.Tip="{Binding LanguageButtonAccessibleName}"><Path Classes="icon-glyph muted" Data="M3,4 L11,4 M7,2 L7,4 M5,4 C5,8 8,11 12,12 M10,4 C10,8 7,11 3,12 M11,18 L15.5,8 L20,18 M12.5,14 L18.5,14" IsHitTestVisible="False" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Context command bar. -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource AlchemyCommandBarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="8,0" ColumnDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,12,0" VerticalAlignment="Center">
          <Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Width="26" Height="26" Stretch="Uniform" Margin="4,0" AutomationProperties.Name="{Binding Text.ProductName}" />
          <TextBlock Grid.Column="1" Text="›" Classes="muted" FontSize="17" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="{Binding CurrentProjectLabel}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentProjectLabel}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="›" Classes="muted" FontSize="17" Margin="10,0" />
          <TextBlock Grid.Column="4" Text="{Binding CurrentPageTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="toolbar" Click="NewProjectClick" ToolTip.Tip="{Binding Text.NewProject}" AutomationProperties.Name="{Binding Text.NewProject}">
            <Path Classes="icon-glyph" Width="24" Height="24" Stretch="None" Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8 M12,11 L12,17 M9,14 L15,14" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="OpenProjectClick" ToolTip.Tip="{Binding Text.OpenProject}" AutomationProperties.Name="{Binding Text.OpenProject}">
            <Path Classes="icon-glyph" Width="24" Height="24" Stretch="None" Data="M3,8 L3,5 L9,5 L11,8 L20,8 L20,11 M3,8 L3,20 L18,20 L21,11 L8,11 L6,14 L3,14" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="SaveProjectClick" ToolTip.Tip="{Binding Text.SaveProject}" AutomationProperties.Name="{Binding Text.SaveProject}">
            <Path Classes="icon-glyph" Width="24" Height="24" Stretch="None" Data="M4,3 L17,3 L21,7 L21,21 L3,21 L3,3 Z M7,3 L7,9 L16,9 L16,3 M7,21 L7,14 L17,14 L17,21 M13,5 L13,7" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="SaveProjectAsClick" ToolTip.Tip="{Binding Text.SaveProjectAs}" AutomationProperties.Name="{Binding Text.SaveProjectAs}">
            <Path Classes="icon-glyph" Width="24" Height="24" Stretch="None" Data="M4,3 L16,3 L19,6 L19,10 M4,3 L4,20 L10,20 M7,3 L7,8 L15,8 L15,3 M7,16 L10,16 M12,18 L19,11 L22,14 L15,21 L11,22 Z M17,13 L20,16" IsHitTestVisible="False" />
          </Button>
          <Border Width="1" Height="28" Background="{DynamicResource AlchemyBorderBrush}" Margin="6,0" />
          <Button Classes="primary" Click="ExportClick" MinWidth="112" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{Binding Text.Export}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon-glyph on-accent" Width="24" Height="24" Stretch="None" Data="M12,3 L12,15 M8,11 L12,15 L16,11 M4,17 L4,21 L20,21 L20,17" IsHitTestVisible="False" />
              <TextBlock Text="{Binding Text.Export}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Reference-driven panels with a read-only preview of the real merged CAST. -->
    <Grid x:Name="AnimationEditor" Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsAnimationsPage}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="180" MaxWidth="360"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="4"/><ColumnDefinition Width="320" MinWidth="280" MaxWidth="460"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="180"/><RowDefinition Height="4"/><RowDefinition Height="2*" MinHeight="160"/></Grid.RowDefinitions>
      <Border x:Name="AnimationDropZone" Classes="workspace-panel" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="AnimationDrop" AutomationProperties.Name="{Binding Text.AnimationWorkspace}">
  <Border.ContextMenu><ContextMenu><MenuItem Header="{Binding Text.ImportAnimationsMenu}" Click="AddAnimationClick" /></ContextMenu></Border.ContextMenu>
  <Grid RowDefinitions="44,32,*,44">
    <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7 M8,11 L13,14 L8,17 Z" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.AssetLibrary}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="AddAnimationClick" ToolTip.Tip="{Binding Text.AddAnimation}" AutomationProperties.Name="{Binding Text.AddAnimation}" ><Path Classes="icon-glyph " Data="M10,3 L10,17 M3,10 L17,10" IsHitTestVisible="False" /></Button></StackPanel></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,0"><TextBlock Text="{Binding Text.Animations}" Classes="field-label" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Animations.Count}" Classes="muted" VerticalAlignment="Center" /></Grid>
    <ListBox Grid.Row="2" Classes="asset-list" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}" BorderThickness="0" AutomationProperties.Name="{Binding Text.Animations}">
      <ListBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspaceAnimation"><Grid ColumnDefinitions="22,*" Margin="0,4"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7 M8,11 L13,14 L8,17 Z" IsHitTestVisible="False" /><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{Binding Text.EmptyAnimationsHelp}" IsVisible="{Binding !HasSelectedAnimation}" Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="14,20" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Background="{DynamicResource AlchemySurfaceBrush}">
      <TextBlock Text="{Binding Text.ImportHint}" Classes="muted" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="RemoveAnimationClick" ToolTip.Tip="{Binding Text.Remove}" AutomationProperties.Name="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedAnimation}"><Path Classes="icon-glyph " Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6" IsHitTestVisible="False" /></Button></StackPanel>
    </Grid>
  </Grid>
</Border>
      <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardIncrement="16" Background="{DynamicResource AlchemyBorderBrush}" AutomationProperties.Name="{Binding Text.ResizePanels}" ToolTip.Tip="{Binding Text.ResizePanels}" />
      <Border Grid.Column="2" Classes="composition-canvas">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7 M8,11 L13,14 L8,17 Z" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Composition}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="BuildPreviewClick" IsEnabled="{Binding HasSelectedAnimation}" ToolTip.Tip="{Binding Text.BuildPreview}" AutomationProperties.Name="{Binding Text.BuildPreview}"><Path Classes="icon-glyph accent" Data="M2,3 L13,3 L13,6 M2,3 L2,14 L6,14 M6,7 L17,7 L17,18 L6,18 Z M9,10 L14,12.5 L9,15 Z" /></Button><Button Classes="panel-command" Click="OpenPreviewClick" ToolTip.Tip="{Binding Text.OpenPreview}" AutomationProperties.Name="{Binding Text.OpenPreview}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button><Button Classes="panel-command" Click="RestoreLayoutClick" ToolTip.Tip="{Binding Text.RestoreLayout}" AutomationProperties.Name="{Binding Text.RestoreLayout}"><Path Classes="icon-glyph" Data="M4,6 A7,7 0 1,1 3,12 M4,2 L4,6 L8,6" IsHitTestVisible="False" /></Button></StackPanel></Grid></Border>
          <local:CastPreviewView Grid.Row="1" DataContext="{Binding Preview}" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardIncrement="16" Background="{DynamicResource AlchemyBorderBrush}" AutomationProperties.Name="{Binding Text.ResizeTracks}" ToolTip.Tip="{Binding Text.ResizeTracks}" />
      <Border Grid.Row="2" Grid.ColumnSpan="3" x:Name="LayerDropZone" Classes="workspace-panel" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="LayerDrop" AutomationProperties.Name="{Binding Text.Layers}">
        <Border.ContextMenu><ContextMenu><MenuItem Header="{Binding Text.ImportLayersMenu}" Click="AddLayerClick" /></ContextMenu></Border.ContextMenu>
        <Grid RowDefinitions="44,30,44,*">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.TrackEditor}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="GenerateSprintBatchClick" IsEnabled="{Binding HasSelectedAnimation}" ToolTip.Tip="{Binding Text.GenerateSprintBatch}" AutomationProperties.Name="{Binding Text.GenerateSprintBatch}"><Path Classes="icon-glyph" Width="24" Height="24" Stretch="None" Data="M12,3 L14,9 L20,12 L14,15 L12,21 L10,15 L4,12 L10,9 Z" /></Button><Button Classes="panel-command" Click="AddLayerClick" ToolTip.Tip="{Binding Text.AddLayer}" AutomationProperties.Name="{Binding Text.AddLayer}" IsEnabled="{Binding HasSelectedAnimation}"><Path Classes="icon-glyph " Data="M10,3 L10,17 M3,10 L17,10" IsHitTestVisible="False" /></Button><Button Classes="panel-command" Click="MoveLayerUpClick" ToolTip.Tip="{Binding Text.MoveUp}" AutomationProperties.Name="{Binding Text.MoveUp}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph " Data="M4,12 L10,6 L16,12 M10,6 L10,17" IsHitTestVisible="False" /></Button><Button Classes="panel-command" Click="MoveLayerDownClick" ToolTip.Tip="{Binding Text.MoveDown}" AutomationProperties.Name="{Binding Text.MoveDown}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph " Data="M4,8 L10,14 L16,8 M10,3 L10,14" IsHitTestVisible="False" /></Button><Button Classes="panel-command" Click="RemoveLayerClick" ToolTip.Tip="{Binding Text.Remove}" AutomationProperties.Name="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph " Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6" IsHitTestVisible="False" /></Button></StackPanel></Grid></Border>
          <Border Grid.Row="1" Classes="track-heading"><Grid ColumnDefinitions="200,*,84"><TextBlock Text="{Binding Text.TrackName}"/><TextBlock Grid.Column="1" Text="{Binding Timeline.ScaleLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Text.Offset}" TextAlignment="Right"/></Grid></Border>
          <Border Grid.Row="2" Classes="track-row" IsVisible="{Binding HasSelectedAnimation}">
            <local:AnimationTrackRow DataContext="{Binding Timeline.BaseTrack}" />
          </Border>
          <ListBox Grid.Row="3" Classes="track-list" ItemsSource="{Binding Timeline.LayerTracks}" SelectedItem="{Binding SelectedTimelineTrack}" BorderThickness="0" AutomationProperties.Name="{Binding Text.Layers}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="local:AnimationTrackItem"><local:AnimationTrackRow /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="{Binding Text.EmptyLayers}" IsVisible="{Binding !SelectedAnimation.Layers.Count}" Classes="muted" Margin="14,10" FontSize="12" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardIncrement="16" Background="{DynamicResource AlchemyBorderBrush}" AutomationProperties.Name="{Binding Text.ResizePanels}" ToolTip.Tip="{Binding Text.ResizePanels}" />
      <Border Grid.Column="4" Grid.RowSpan="3" Classes="workspace-panel">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Inspector}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"></StackPanel></Grid></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding HasSelectedAnimation}">
              <Expander Classes="property-group" Header="{Binding Text.AnimationDetails}" IsExpanded="True"><StackPanel><TextBlock Classes="field-label" Text="{Binding Text.AnimationFile}" /><Grid ColumnDefinitions="*,4,44"><TextBox Text="{Binding SelectedAnimation.Name}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="AnimationPathDrop" AutomationProperties.Name="{Binding Text.AnimationFile}" ToolTip.Tip="{Binding SelectedAnimation.Name}" /><Button Grid.Column="2" Classes="icon" Click="BrowseAnimationClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph " Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" IsHitTestVisible="False" /></Button></Grid></StackPanel></Expander>
              <Expander Classes="property-group" Header="{Binding Text.SelectedLayer}" IsExpanded="true" IsVisible="{Binding HasSelectedLayer}"><StackPanel Spacing="12"><StackPanel><TextBlock Text="{Binding Text.LayerFile}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedLayer.Name}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="LayerPathDrop" AutomationProperties.Name="{Binding Text.LayerFile}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseLayerClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel><Grid ColumnDefinitions="*,12,84"><StackPanel><TextBlock Text="{Binding Text.LayerMode}" Classes="field-label" /><ComboBox ItemsSource="{Binding Text.LayerTypes}" SelectedIndex="{Binding SelectedLayer.TypeIndex}" AutomationProperties.Name="{Binding Text.LayerMode}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.Offset}" Classes="field-label" /><TextBox Text="{Binding SelectedLayer.Offset}" AutomationProperties.Name="{Binding Text.Offset}" /></StackPanel></Grid></StackPanel></Expander>
              <Expander Classes="property-group" Header="{Binding Text.ExportTarget}" IsExpanded="true" ><StackPanel Spacing="12"><StackPanel><TextBlock Text="{Binding Text.OutputName}" Classes="field-label" /><TextBox Text="{Binding SelectedAnimation.OutputName}" AutomationProperties.Name="{Binding Text.OutputName}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.Framerate}" Classes="field-label" /><TextBox Text="{Binding SelectedAnimation.OutputFramerate}" AutomationProperties.Name="{Binding Text.Framerate}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.OutputFolder}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.OutputFolder}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="OutputPathDrop" AutomationProperties.Name="{Binding Text.OutputFolder}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseOutputFolderClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel></StackPanel></Expander>
              <Expander Classes="property-group" Header="{Binding Text.HandPoses}" IsExpanded="false" ><StackPanel Spacing="12"><StackPanel><TextBlock Text="{Binding Text.LeftPose}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.LeftHandPoseFile}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="LeftPosePathDrop" AutomationProperties.Name="{Binding Text.LeftPose}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseLeftPoseClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel><StackPanel><TextBlock Text="{Binding Text.RightPose}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.RightHandPoseFile}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="RightPosePathDrop" AutomationProperties.Name="{Binding Text.RightPose}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseRightPoseClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel></StackPanel></Expander>
              <Expander Classes="property-group" Header="{Binding Text.IkControls}" IsExpanded="false" ><StackPanel Spacing="10"><CheckBox IsChecked="{Binding SelectedAnimation.EnableLeftHandIK}" Content="{Binding Text.EnableLeftIk}" AutomationProperties.Name="{Binding Text.EnableLeftIk}" /><TextBox Text="{Binding SelectedAnimation.LeftIKTargetBoneName}" PlaceholderText="{Binding Text.LeftTargetOverride}" AutomationProperties.Name="{Binding Text.LeftTargetOverride}" /><CheckBox IsChecked="{Binding SelectedAnimation.EnableRightHandIK}" Content="{Binding Text.EnableRightIk}" AutomationProperties.Name="{Binding Text.EnableRightIk}" /><TextBox Text="{Binding SelectedAnimation.RightIKTargetBoneName}" PlaceholderText="{Binding Text.RightTargetOverride}" AutomationProperties.Name="{Binding Text.RightTargetOverride}" /></StackPanel></Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="PartsEditor" Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsModelPartsPage}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="180" MaxWidth="360"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="4"/><ColumnDefinition Width="320" MinWidth="280" MaxWidth="460"/></Grid.ColumnDefinitions>
      <Border x:Name="PartDropZone" Classes="workspace-panel" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="PartDrop" AutomationProperties.Name="{Binding Text.ModelParts}">
  <Border.ContextMenu><ContextMenu><MenuItem Header="{Binding Text.ImportPartsMenu}" Click="AddPartClick" /></ContextMenu></Border.ContextMenu>
  <Grid RowDefinitions="44,32,*,44">
    <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.AssetLibrary}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="AddPartClick" ToolTip.Tip="{Binding Text.AddPart}" AutomationProperties.Name="{Binding Text.AddPart}" ><Path Classes="icon-glyph " Data="M10,3 L10,17 M3,10 L17,10" IsHitTestVisible="False" /></Button></StackPanel></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,0"><TextBlock Text="{Binding Text.ModelParts}" Classes="field-label" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Parts.Count}" Classes="muted" VerticalAlignment="Center" /></Grid>
    <ListBox Grid.Row="2" Classes="asset-list" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" BorderThickness="0" AutomationProperties.Name="{Binding Text.ModelParts}">
      <ListBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspacePart"><Grid ColumnDefinitions="22,*" Margin="0,4"><Path Classes="icon-glyph muted" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" /></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{Binding Text.EmptyPartsHelp}" IsVisible="{Binding !HasSelectedPart}" Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="14,20" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Background="{DynamicResource AlchemySurfaceBrush}">
      <TextBlock Text="{Binding Text.Order}" Classes="muted" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="MovePartUpClick" ToolTip.Tip="{Binding Text.MoveUp}" AutomationProperties.Name="{Binding Text.MoveUp}" ><Path Classes="icon-glyph " Data="M4,12 L10,6 L16,12 M10,6 L10,17" IsHitTestVisible="False" /></Button><Button Classes="panel-command" Click="MovePartDownClick" ToolTip.Tip="{Binding Text.MoveDown}" AutomationProperties.Name="{Binding Text.MoveDown}" ><Path Classes="icon-glyph " Data="M4,8 L10,14 L16,8 M10,3 L10,14" IsHitTestVisible="False" /></Button><Button Classes="panel-command" Click="RemovePartClick" ToolTip.Tip="{Binding Text.Remove}" AutomationProperties.Name="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedPart}"><Path Classes="icon-glyph " Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6" IsHitTestVisible="False" /></Button></StackPanel>
    </Grid>
  </Grid>
</Border>
      <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardIncrement="16" Background="{DynamicResource AlchemyBorderBrush}" AutomationProperties.Name="{Binding Text.ResizePanels}" ToolTip.Tip="{Binding Text.ResizePanels}" />
      <Border Grid.Column="2" Classes="composition-canvas">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Composition}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="BuildPreviewClick" IsEnabled="{Binding HasSelectedAnimation}" ToolTip.Tip="{Binding Text.BuildPreview}" AutomationProperties.Name="{Binding Text.BuildPreview}"><Path Classes="icon-glyph accent" Data="M2,3 L13,3 L13,6 M2,3 L2,14 L6,14 M6,7 L17,7 L17,18 L6,18 Z M9,10 L14,12.5 L9,15 Z" /></Button><Button Classes="panel-command" Click="OpenPreviewClick" ToolTip.Tip="{Binding Text.OpenPreview}" AutomationProperties.Name="{Binding Text.OpenPreview}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button><Button Classes="panel-command" Click="RestoreLayoutClick" ToolTip.Tip="{Binding Text.RestoreLayout}" AutomationProperties.Name="{Binding Text.RestoreLayout}"><Path Classes="icon-glyph" Data="M4,6 A7,7 0 1,1 3,12 M4,2 L4,6 L8,6" IsHitTestVisible="False" /></Button></StackPanel></Grid></Border>
          <local:CastPreviewView Grid.Row="1" DataContext="{Binding Preview}" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardIncrement="16" Background="{DynamicResource AlchemyBorderBrush}" AutomationProperties.Name="{Binding Text.ResizePanels}" ToolTip.Tip="{Binding Text.ResizePanels}" />
      <Border Grid.Column="4" Classes="workspace-panel">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Inspector}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"></StackPanel></Grid></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding HasSelectedPart}">
            <Expander Classes="property-group" Header="{Binding Text.ModelFile}" IsExpanded="True"><StackPanel><TextBlock Classes="field-label" Text="{Binding Text.ModelFile}" /><Grid ColumnDefinitions="*,4,44"><TextBox Text="{Binding SelectedPart.FilePath}" LostFocus="PartPathLostFocus" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="PartPathDrop" AutomationProperties.Name="{Binding Text.ModelFile}" ToolTip.Tip="{Binding SelectedPart.FilePath}" /><Button Grid.Column="2" Classes="icon" Click="BrowsePartClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph " Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" IsHitTestVisible="False" /></Button></Grid></StackPanel></Expander>
            <Expander Classes="property-group" Header="{Binding Text.PartDetails}" IsExpanded="true" ><StackPanel Spacing="12"><StackPanel><TextBlock Text="{Binding Text.PartType}" Classes="field-label" /><ComboBox ItemsSource="{Binding Text.PartTypes}" SelectedIndex="{Binding SelectedPart.TypeIndex}" AutomationProperties.Name="{Binding Text.PartType}" /></StackPanel><Border IsVisible="{Binding HasSelectedPartClassification}" Background="#162B78D0" BorderBrush="#665AAAEF" BorderThickness="1" CornerRadius="5" Padding="10,8"><TextBlock Text="{Binding SelectedPartDetection}" Classes="muted" TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="{Binding SelectedPartDetection}" /></Border><StackPanel><TextBlock Text="{Binding Text.ParentBone}" Classes="field-label" /><TextBox Text="{Binding SelectedPart.ParentBoneTag}" AutomationProperties.Name="{Binding Text.ParentBone}" /></StackPanel></StackPanel></Expander>
            <Border Classes="inspector-section"><TextBlock Text="{Binding Text.PartOrderHelp}" Classes="muted" TextWrapping="Wrap" FontSize="12" /></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <!-- Settings workspace -->
    <ScrollViewer Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsSettingsPage}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,12,14,28" Spacing="14" MaxWidth="1080">
        <StackPanel Spacing="3"><TextBlock Text="{Binding Text.OutputSettings}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Text.OutputSettingsHelp}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
        <Grid ColumnDefinitions="*,16,*">
          <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,18 L17,18 L17,16" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.DefaultOutputFormat}" Classes="card-title" /><TextBlock Text="{Binding Text.FormatHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><ComboBox ItemsSource="{Binding OutputFormats}" SelectedIndex="{Binding OutputFormatIndex}" AutomationProperties.Name="{Binding Text.DefaultOutputFormat}" /><CheckBox IsChecked="{Binding Workspace.CastAnimationOnly}" Content="{Binding Text.AnimationOnlyCast}" IsEnabled="{Binding IsCastOutput}" AutomationProperties.Name="{Binding Text.AnimationOnlyCast}" /><TextBlock Text="{Binding Text.AnimationOnlyHelp}" Classes="muted" TextWrapping="Wrap" /><CheckBox IsChecked="{Binding Workspace.BakeRelevantBonesOnly}" Content="{Binding Text.SelectiveBake}" AutomationProperties.Name="{Binding Text.SelectiveBake}" /><TextBlock Text="{Binding Text.SelectiveBakeHelp}" Classes="muted" TextWrapping="Wrap" /><CheckBox IsChecked="{Binding Workspace.MatchOldCallOfDuty}" Content="{Binding Text.OldCod}" AutomationProperties.Name="{Binding Text.OldCod}" /></StackPanel></Border>
          <Border Grid.Column="2" Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.NamingAndLanguage}" Classes="card-title" /><TextBlock Text="{Binding Text.NamingHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><StackPanel><TextBlock Text="{Binding Text.Prefix}" Classes="field-label" /><TextBox Text="{Binding Workspace.OutputPrefix}" AutomationProperties.Name="{Binding Text.Prefix}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.Suffix}" Classes="field-label" /><TextBox Text="{Binding Workspace.OutputSuffix}" AutomationProperties.Name="{Binding Text.Suffix}" /></StackPanel><TextBlock Text="{Binding Text.Language}" Classes="field-label" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="LanguageClick" Content="{Binding LanguageButtonLabel}" AutomationProperties.Name="{Binding LanguageButtonAccessibleName}" /><Button Classes="secondary" Click="SystemLanguageClick" Content="{Binding Text.FollowSystem}" AutomationProperties.Name="{Binding Text.FollowSystem}" /></StackPanel></StackPanel></Border>
        </Grid>
        <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M3,16 L7,12 L10,15 L17,8 M3,5 L6,8 L10,4 L17,11 M3,16 L3,5 M17,8 L17,11" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.IkDefaults}" Classes="card-title" /><TextBlock Text="{Binding Text.IkHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><Grid ColumnDefinitions="*,24,*"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.LeftIk}" Classes="eyebrow" /><TextBlock Text="{Binding Text.StartBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKStartBoneName}" AutomationProperties.Name="{Binding Text.LeftStartBone}" /><TextBlock Text="{Binding Text.MiddleBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKMidBoneName}" AutomationProperties.Name="{Binding Text.LeftMiddleBone}" /><TextBlock Text="{Binding Text.EndBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKEndBoneName}" AutomationProperties.Name="{Binding Text.LeftEndBone}" /><TextBlock Text="{Binding Text.TargetBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKTargetBoneName}" AutomationProperties.Name="{Binding Text.LeftTargetBone}" /></StackPanel><StackPanel Grid.Column="2" Spacing="10"><TextBlock Text="{Binding Text.RightIk}" Classes="eyebrow" /><TextBlock Text="{Binding Text.StartBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKStartBoneName}" AutomationProperties.Name="{Binding Text.RightStartBone}" /><TextBlock Text="{Binding Text.MiddleBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKMidBoneName}" AutomationProperties.Name="{Binding Text.RightMiddleBone}" /><TextBlock Text="{Binding Text.EndBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKEndBoneName}" AutomationProperties.Name="{Binding Text.RightEndBone}" /><TextBlock Text="{Binding Text.TargetBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKTargetBoneName}" AutomationProperties.Name="{Binding Text.RightTargetBone}" /></StackPanel></Grid></StackPanel></Border>
        <Button Classes="primary" Click="SaveDefaultsClick" Content="{Binding Text.SaveDefaults}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.SaveDefaults}" />
      </StackPanel>
    </ScrollViewer>

    <!-- About workspace -->
    <ScrollViewer Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsAboutPage}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,38" Spacing="18" MaxWidth="900" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="116,26,*"><Border Width="116" Height="116" Padding="12" Background="{DynamicResource AlchemySurfaceBrush}" BorderBrush="{DynamicResource AlchemyBorderStrongBrush}" BorderThickness="1" CornerRadius="26"><Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Stretch="Uniform" AutomationProperties.Name="{Binding Text.ApplicationIcon}" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7"><TextBlock Text="{Binding Text.AboutTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Text.AboutSubtitle}" Classes="muted" FontSize="15" TextWrapping="Wrap" /><Border Classes="preview-badge" HorizontalAlignment="Left"><TextBlock Text="1.3.0-preview.12 · .NET 11 · Native AOT" Classes="eyebrow" /></Border></StackPanel></Grid>
        <Border Classes="hero-card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.AboutOverview}" TextWrapping="Wrap" FontSize="16" /><TextBlock Text="{Binding Text.Capabilities}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
        <Grid ColumnDefinitions="*,16,*"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.Build}" Classes="card-title" /><TextBlock Text="{Binding RuntimeDescription}" Classes="muted" /><TextBlock Text="{Binding Text.License}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="2" Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.ProjectRepositoryTitle}" Classes="card-title" /><TextBlock Text="{Binding Text.ProjectRepositoryHelp}" Classes="muted" TextWrapping="Wrap" /><Button Classes="secondary" Click="OpenProjectRepositoryClick" Content="{Binding ProjectRepositoryDisplayName}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.OpenProjectRepository}" ToolTip.Tip="{Binding Text.OpenProjectRepository}" /><Border Height="1" Margin="0,4" Background="{DynamicResource AlchemyBorderBrush}" /><TextBlock Text="{Binding Text.UpstreamTitle}" Classes="card-title" /><TextBlock Text="{Binding Text.UpstreamHelp}" Classes="muted" TextWrapping="Wrap" /><Button Classes="secondary" Click="OpenUpstreamClick" Content="{Binding Text.Upstream}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.Upstream}" /></StackPanel></Border></Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.ColumnSpan="2" Grid.Row="2" Background="{DynamicResource AlchemyCommandBarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0" ColumnDefinitions="Auto,8,*,Auto" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AlchemySuccessBrush}" /><TextBlock Grid.Column="2" Text="{Binding FooterStatus}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Version}" Classes="muted" FontSize="11" /></Grid>
    </Border>

    <!-- Window-owned overlays keep progress and feedback centered and keyboard-contained. -->
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsBusy}" Background="#B5000000" ZIndex="20" AutomationProperties.Name="{Binding BusyMessage}" AutomationProperties.LiveSetting="Polite">
      <Border Classes="dialog-card" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16"><ProgressBar IsIndeterminate="True" Height="5" /><TextBlock Text="{Binding BusyMessage}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" /></StackPanel></Border>
    </Grid>
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsDialogOpen}" Background="#B5000000" ZIndex="30" KeyDown="DialogKeyDown">
      <Border Classes="dialog-card" Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
        <Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="42,14,*" Margin="0,0,0,15"><Border Width="42" Height="42" CornerRadius="8" Background="#1A4CC2FF"><Path Classes="icon-glyph accent" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M10,6 L10,11 M10,14 L10,15" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Text.Notification}" Classes="eyebrow" /><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Grid><ScrollViewer Grid.Row="1" MaxHeight="330"><TextBlock Text="{Binding DialogMessage}" Classes="muted" TextWrapping="Wrap" /></ScrollViewer><Button x:Name="DialogCloseButton" Grid.Row="2" Classes="primary" Click="CloseDialogClick" Content="{Binding Text.Close}" HorizontalAlignment="Right" Margin="0,18,0,0" AutomationProperties.Name="{Binding Text.Close}" /></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
