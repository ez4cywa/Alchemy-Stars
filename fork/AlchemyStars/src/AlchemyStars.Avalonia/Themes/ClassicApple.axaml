<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AlchemyStars.Avalonia.ClassicAppleStyles">
  <!-- Platinum surfaces, graphite selection, rounded symbols. Keep the product's layout and hit targets. -->
  <Style Selector="Window, MenuItem, ToolTip">
    <Setter Property="FontFamily" Value="SF Pro Text, Helvetica Neue, Segoe UI, Microsoft YaHei UI, sans-serif" />
  </Style>
  <Style Selector="TextBlock.display-title">
    <Setter Property="FontFamily" Value="SF Pro Display, Helvetica Neue, Segoe UI, Microsoft YaHei UI, sans-serif" />
  </Style>
  <Style Selector="Border.command-bar"><Setter Property="Background" Value="{DynamicResource AppleChromeBrush}" /></Style>
  <Style Selector="TextBlock.card-title, TextBlock.dock-title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="LetterSpacing" Value="0" />
  </Style>
  <Style Selector="Border.workspace-panel, Border.composition-canvas, Border.card, Border.subcard, Border.hero-card, Border.dialog-card">
    <Setter Property="CornerRadius" Value="{DynamicResource AppearancePanelRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.card, Border.subcard, Border.hero-card, Border.dialog-card">
    <Setter Property="CornerRadius" Value="{DynamicResource AppearanceCardRadius}" />
  </Style>
  <Style Selector="Border.dock-header, Border.track-heading, Border.canvas-footer">
    <Setter Property="Background" Value="{DynamicResource AppleHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
  </Style>
  <Style Selector="Border.feature-icon, Border.preview-badge, Border.count-badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource AppleHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
  </Style>

  <Style Selector="Button, Button.icon, Button.toolbar, Button.panel-command, Button.activity, Button.activity.selected, Button.subtle, Button.primary, Button.secondary, ToggleButton.preview-command">
    <Setter Property="CornerRadius" Value="{DynamicResource AppearanceButtonRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppleButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pressed, ToggleButton.preview-command:pressed"><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="Button /template/ ContentPresenter, Button.icon /template/ ContentPresenter, Button.secondary /template/ ContentPresenter, Button.toolbar /template/ ContentPresenter, Button.panel-command /template/ ContentPresenter, Button.activity /template/ ContentPresenter, Button.subtle /template/ ContentPresenter, ToggleButton.preview-command /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppleButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppearanceButtonRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearanceRaisedShadow}" />
  </Style>
  <!-- Toolbar items stay quiet until selected; visible bezels are reserved for actions. -->
  <Style Selector="Button.toolbar /template/ ContentPresenter, Button.panel-command /template/ ContentPresenter, Button.activity /template/ ContentPresenter, Button.subtle /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Button.activity.selected /template/ ContentPresenter, ToggleButton.preview-command:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppleButtonPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearanceInsetShadow}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter, ToggleButton.preview-command:pointerover /template/ ContentPresenter, Border.command-bar Button.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppleButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleHoverEdgeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter, ToggleButton.preview-command:pressed /template/ ContentPresenter, Border.command-bar Button.toolbar:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppleButtonPressedBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearanceInsetShadow}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter, ToggleButton.preview-command:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppleFocusShadow}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="CornerRadius" Value="{DynamicResource AppearanceActionRadius}" />
    <Setter Property="Background" Value="{DynamicResource AppleActionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource AppearanceActionRadius}" />
    <Setter Property="Background" Value="{DynamicResource AppleActionBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyActionBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppleActionHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AppleActionPressedBrush}" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter, ToggleButton.preview-command:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource AlchemyCanvasBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement, ComboBox /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource AlchemyCanvasBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearanceInsetShadow}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, ComboBox:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AppleHoverEdgeBrush}" />
  </Style>
  <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement, ComboBox:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppleFocusShadow}" />
  </Style>
  <Style Selector="ComboBox:not(.native-template) /template/ Border#DropDownOverlay">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Background" Value="{DynamicResource AppleButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="0,5,5,0" />
  </Style>
  <Style Selector="ComboBox:not(.native-template) /template/ PathIcon#DropDownGlyph">
    <Setter Property="Data" Value="M0,3 L4,0 L8,3 L7,4 L4,1.8 L1,4 Z M0,7 L1,6 L4,8.2 L7,6 L8,7 L4,10 Z" />
    <Setter Property="Width" Value="8" /><Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
  </Style>
  <Style Selector="ComboBox:not(.native-template) /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearancePanelShadow}" />
  </Style>
  <Style Selector="TextBox:disabled, ComboBox:disabled"><Setter Property="Opacity" Value="0.5" /></Style>

  <Style Selector="CheckBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="20,*" Background="Transparent">
          <Border Name="AppleCheckBox" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource AppleButtonBrush}" BorderBrush="{DynamicResource AppleEdgeBrush}" BorderThickness="1" BoxShadow="{DynamicResource AppearanceRaisedShadow}">
            <Grid>
              <Path Name="AppleCheckMark" IsVisible="False" Data="M2,6 L5,9 L11,2.5" Stroke="White" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Width="13" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Name="AppleIndeterminate" IsVisible="False" Height="2" Width="8" CornerRadius="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="6,0,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" VerticalContentAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#AppleCheckBox, CheckBox:indeterminate /template/ Border#AppleCheckBox"><Setter Property="Background" Value="{DynamicResource AppleActionBrush}" /></Style>
  <Style Selector="CheckBox:checked /template/ Path#AppleCheckMark"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="CheckBox:indeterminate /template/ Border#AppleIndeterminate"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="CheckBox:pointerover /template/ Border#AppleCheckBox"><Setter Property="BorderBrush" Value="{DynamicResource AppleHoverEdgeBrush}" /></Style>
  <Style Selector="CheckBox:pressed /template/ Border#AppleCheckBox"><Setter Property="BoxShadow" Value="{DynamicResource AppearanceInsetShadow}" /></Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#AppleCheckBox"><Setter Property="BoxShadow" Value="{DynamicResource AppleFocusShadow}" /></Style>
  <Style Selector="CheckBox:disabled"><Setter Property="Opacity" Value="0.48" /></Style>
  <Style Selector="ToggleButton.dual-export-switch:not(.native-template)">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Name="AppleSwitchTrack" Width="40" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AppleButtonPressedBrush}" BorderBrush="{DynamicResource AppleEdgeBrush}" BorderThickness="1" CornerRadius="12" BoxShadow="{DynamicResource AppearanceInsetShadow}">
            <Border Name="AppleSwitchThumb" Width="18" Height="18" Margin="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AppleThumbBrush}" BorderBrush="{DynamicResource AppleEdgeBrush}" BorderThickness="0.5" CornerRadius="9" BoxShadow="{DynamicResource AppearanceRaisedShadow}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.dual-export-switch:checked /template/ Border#AppleSwitchTrack"><Setter Property="Background" Value="{DynamicResource AppleActionBrush}" /></Style>
  <Style Selector="ToggleButton.dual-export-switch:checked /template/ Border#AppleSwitchThumb"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  <Style Selector="ToggleButton.dual-export-switch:focus-visible /template/ Border#AppleSwitchTrack"><Setter Property="BoxShadow" Value="{DynamicResource AppleFocusShadow}" /></Style>
  <Style Selector="ToggleButton.dual-export-switch:pointerover /template/ Border#AppleSwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource AppleHoverEdgeBrush}" /></Style>
  <Style Selector="ToggleButton.dual-export-switch:pressed /template/ Border#AppleSwitchThumb"><Setter Property="Background" Value="{DynamicResource AppleButtonHoverBrush}" /></Style>

  <Style Selector="Expander.property-group /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource AppleHeaderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Expander.property-group /template/ ToggleButton:pointerover"><Setter Property="Background" Value="{DynamicResource AppleButtonHoverBrush}" /></Style>
  <Style Selector="ListBox.asset-list, ListBox.track-list"><Setter Property="Background" Value="{DynamicResource AlchemyCanvasBrush}" /></Style>
  <Style Selector="ListBoxItem, ListBox.asset-list ListBoxItem, ListBox.track-list ListBoxItem, ComboBoxItem, MenuItem"><Setter Property="CornerRadius" Value="5" /></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppearanceInsetShadow}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border"><Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" /><Setter Property="CornerRadius" Value="5" /></Style>
  <Style Selector="ContextMenu, ToolTip">
    <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppleEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- The thumb fits inside the existing 20px playback slot; no oversized focus ornament. -->
  <Style Selector="Slider.preview-scrubber /template/ Thumb">
    <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="AppleScrubThumb" Background="{DynamicResource AppleThumbBrush}" BorderBrush="{DynamicResource AppleEdgeBrush}" BorderThickness="1" CornerRadius="8" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider.preview-scrubber:pointerover /template/ Thumb"><Setter Property="Opacity" Value="0.9" /></Style>
  <Style Selector="Slider.preview-scrubber:focus-visible /template/ Thumb"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>
  <Style Selector="ScrollBar"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="2" Background="{DynamicResource AlchemyMutedTextBrush}" CornerRadius="8" Opacity="0.55" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb"><Setter Property="Opacity" Value="0.85" /></Style>
  <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AppleActionBrush}" /><Setter Property="Background" Value="{DynamicResource AlchemyPressedBrush}" /></Style>
  <Style Selector="ProgressBar /template/ Border"><Setter Property="CornerRadius" Value="4" /></Style>
  <Style Selector="ContentControl.clip"><Setter Property="CornerRadius" Value="5" /><Setter Property="BorderThickness" Value="1" /></Style>
</Styles>
