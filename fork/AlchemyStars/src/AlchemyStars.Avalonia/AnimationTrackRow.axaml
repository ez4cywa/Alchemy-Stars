<UserControl
    x:Class="AlchemyStars.Avalonia.AnimationTrackRow"
    x:DataType="local:AnimationTrackItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia">
  <Grid ColumnDefinitions="200,*,84" Margin="0,4">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <local:ThemedIcon Classes="product-icon" Width="20" Height="20" IsVisible="{Binding IsBase}" IsHitTestVisible="False" Glyph="animation-library" />
      <local:ThemedIcon Classes="product-icon" Width="20" Height="20" IsVisible="{Binding IsLayer}" IsHitTestVisible="False" Glyph="animation-layers" />
      <TextBlock Text="{Binding TrackLabel}" Width="162" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
    </StackPanel>
    <Grid Grid.Column="1" Classes="track-lane">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeadingLength}" />
        <ColumnDefinition Width="{Binding DurationLength}" />
        <ColumnDefinition Width="{Binding TrailingLength}" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="1"
                      Classes="clip"
                      Classes.base-clip="{Binding IsBase}"
                      Classes.layer-clip="{Binding IsLayer}"
                      MinWidth="64"
                      Focusable="False"
                      ToolTip.Tip="{Binding Tooltip}"
                      AutomationProperties.Name="{Binding AccessibleName}"
                      AutomationProperties.AccessibilityView="Content"
                      AutomationProperties.IsControlElementOverride="True">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding FrameLabel}" Classes="clip-frame-label" />
        </Grid>
      </ContentControl>
    </Grid>
    <TextBlock Grid.Column="2" Text="{Binding OffsetLabel}" Classes="muted" VerticalAlignment="Center" TextAlignment="Right" />
  </Grid>
</UserControl>
