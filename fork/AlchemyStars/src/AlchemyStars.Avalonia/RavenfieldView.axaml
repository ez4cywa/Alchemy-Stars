<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AlchemyStars.Avalonia" xmlns:engine="using:AlchemyStars.Engine" x:Class="AlchemyStars.Avalonia.RavenfieldView" x:DataType="local:MainWindowViewModel">
<Border Classes="card"><StackPanel Spacing="12" IsEnabled="{Binding CanInteract}">
<TextBlock Text="{Binding Text.RfTitle}" Classes="card-title" /><TextBlock Text="{Binding Text.RfHelp}" TextWrapping="Wrap" Classes="muted" />
<TextBlock Text="{Binding Text.RfMode}" Classes="field-label" TextWrapping="Wrap" />
<ComboBox x:Name="RfMode" ItemsSource="{Binding RavenfieldModes}" SelectedIndex="{Binding RavenfieldModeIndex}" AutomationProperties.Name="{Binding Text.RfMode}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock x:Name="RfModeHelp" Text="{Binding RavenfieldModeHelp}" TextWrapping="Wrap" Classes="muted" />
<TextBlock Text="{Binding Text.RfSource}" Classes="field-label" TextWrapping="Wrap" />
<Grid ColumnDefinitions="*,12,Auto"><TextBox Text="{Binding Workspace.Ravenfield.RfSourcePath}" AutomationProperties.Name="{Binding Text.RfSource}" /><Button Grid.Column="2" Click="BrowseClick" Content="{Binding Text.RfBrowse}" /></Grid>
<TextBlock Text="{Binding Text.RfIdle}" Classes="field-label" TextWrapping="Wrap" />
<ComboBox x:Name="RfReference" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedRavenfieldAnimation}" AutomationProperties.Name="{Binding Text.RfIdle}"><ComboBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspaceAnimation"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock Text="{Binding Text.RfUnit}" Classes="field-label" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding RavenfieldUnits}" SelectedItem="{Binding Workspace.Ravenfield.SourceUnit}" AutomationProperties.Name="{Binding Text.RfUnit}" /><TextBlock Text="{Binding Text.RfUnitHelp}" Classes="muted" TextWrapping="Wrap" />
<Grid ColumnDefinitions="*,16,*">
<StackPanel><TextBlock Text="{Binding Text.RfFrame}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown Value="{Binding Workspace.Ravenfield.IdleFrame}" Minimum="0" Increment="1" FormatString="0" AutomationProperties.Name="{Binding Text.RfFrame}" /></StackPanel>

<StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.RfScale}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown x:Name="RfScale" Value="{Binding Workspace.Ravenfield.HandScale}" Minimum="0.1" Maximum="10" Increment="0.01" FormatString="0.000" AutomationProperties.Name="{Binding Text.RfScale}" /></StackPanel>
</Grid>
<TextBlock Text="{Binding Text.RfAxesHelp}" Classes="muted" TextWrapping="Wrap" />
<TextBlock Text="{Binding Text.RfUntaggedAxis}" Classes="field-label" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding RavenfieldUntaggedAxes}" SelectedItem="{Binding Workspace.Ravenfield.UntaggedModelUpAxis}" AutomationProperties.Name="{Binding Text.RfUntaggedAxis}" /><TextBlock Text="{Binding Text.RfUntaggedAxisHelp}" Classes="muted" TextWrapping="Wrap" />
<Expander x:Name="RfAdvanced" Header="{Binding Text.RfAdvanced}" HorizontalAlignment="Stretch"><Grid ColumnDefinitions="*,24,*" Margin="0,12,0,0"><StackPanel Spacing="8">
<TextBlock Text="{Binding Text.RfLeft}" Classes="eyebrow" />
<TextBlock Text="{Binding Text.RfPosition}" Classes="field-label" TextWrapping="Wrap" />
<Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto,8,Auto"><TextBlock Grid.Row="0" Text="X" VerticalAlignment="Center" /><NumericUpDown Grid.Row="0" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.PositionX}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Left position X (m)" /><TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.PositionY}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Left position Y (m)" /><TextBlock Grid.Row="4" Text="Z" VerticalAlignment="Center" /><NumericUpDown Grid.Row="4" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.PositionZ}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Left position Z (m)" /></Grid>
<TextBlock Text="{Binding Text.RfRotation}" Classes="field-label" TextWrapping="Wrap" />
<Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto,8,Auto"><TextBlock Grid.Row="0" Text="X" VerticalAlignment="Center" /><NumericUpDown Grid.Row="0" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.RotationX}" Increment="1" FormatString="0.0" AutomationProperties.Name="Left rotation X (degrees)" /><TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.RotationY}" Increment="1" FormatString="0.0" AutomationProperties.Name="Left rotation Y (degrees)" /><TextBlock Grid.Row="4" Text="Z" VerticalAlignment="Center" /><NumericUpDown Grid.Row="4" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Left.RotationZ}" Increment="1" FormatString="0.0" AutomationProperties.Name="Left rotation Z (degrees)" /></Grid>
<TextBlock Text="{Binding Text.RfElbow}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown Value="{Binding Workspace.Ravenfield.Left.ElbowSwivel}" Minimum="-180" Maximum="180" Increment="1" FormatString="0.0" AutomationProperties.Name="Left elbow swivel (degrees)" />
<TextBlock Text="{Binding Text.RfFinger}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown Value="{Binding Workspace.Ravenfield.Left.FingerCurl}" Minimum="-90" Maximum="90" Increment="1" FormatString="0.0" AutomationProperties.Name="Left finger curl (degrees)" />
</StackPanel><StackPanel Grid.Column="2" Spacing="8">
<TextBlock Text="{Binding Text.RfRight}" Classes="eyebrow" />
<TextBlock Text="{Binding Text.RfPosition}" Classes="field-label" TextWrapping="Wrap" />
<Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto,8,Auto"><TextBlock Grid.Row="0" Text="X" VerticalAlignment="Center" /><NumericUpDown Grid.Row="0" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.PositionX}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Right position X (m)" /><TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.PositionY}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Right position Y (m)" /><TextBlock Grid.Row="4" Text="Z" VerticalAlignment="Center" /><NumericUpDown Grid.Row="4" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.PositionZ}" Increment="0.001" FormatString="0.000" AutomationProperties.Name="Right position Z (m)" /></Grid>
<TextBlock Text="{Binding Text.RfRotation}" Classes="field-label" TextWrapping="Wrap" />
<Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto,8,Auto"><TextBlock Grid.Row="0" Text="X" VerticalAlignment="Center" /><NumericUpDown Grid.Row="0" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.RotationX}" Increment="1" FormatString="0.0" AutomationProperties.Name="Right rotation X (degrees)" /><TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.RotationY}" Increment="1" FormatString="0.0" AutomationProperties.Name="Right rotation Y (degrees)" /><TextBlock Grid.Row="4" Text="Z" VerticalAlignment="Center" /><NumericUpDown Grid.Row="4" Grid.Column="2" Minimum="-10000" Maximum="10000" Value="{Binding Workspace.Ravenfield.Right.RotationZ}" Increment="1" FormatString="0.0" AutomationProperties.Name="Right rotation Z (degrees)" /></Grid>
<TextBlock Text="{Binding Text.RfElbow}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown Value="{Binding Workspace.Ravenfield.Right.ElbowSwivel}" Minimum="-180" Maximum="180" Increment="1" FormatString="0.0" AutomationProperties.Name="Right elbow swivel (degrees)" />
<TextBlock Text="{Binding Text.RfFinger}" Classes="field-label" TextWrapping="Wrap" /><NumericUpDown Value="{Binding Workspace.Ravenfield.Right.FingerCurl}" Minimum="-90" Maximum="90" Increment="1" FormatString="0.0" AutomationProperties.Name="Right finger curl (degrees)" />
</StackPanel></Grid></Expander>
<WrapPanel><Button Classes="primary" Click="AdaptClick" Content="{Binding Text.RfAdapt}" IsEnabled="{Binding HasRavenfieldReference}" Margin="0,0,8,8" /><Button Click="BlendClick" Content="{Binding Text.RfOpenBlend}" IsVisible="{Binding HasRavenfieldResult}" Margin="0,0,8,8" /><Button Click="PreviewClick" Content="{Binding Text.RfOpenPreview}" IsVisible="{Binding HasRavenfieldResult}" Margin="0,0,8,8" /></WrapPanel>
</StackPanel></Border>
</UserControl>
