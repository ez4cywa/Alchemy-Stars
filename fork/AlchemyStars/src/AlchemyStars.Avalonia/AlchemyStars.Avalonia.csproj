<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>AlchemyStars.Avalonia</AssemblyName>
    <RootNamespace>AlchemyStars.Avalonia</RootNamespace>
    <Product>Alchemy Stars</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AlchemyStarsIcon.ico</ApplicationIcon>
    <Version>1.3.0-preview.22</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <InformationalVersion>1.3.0-preview.22</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlchemyStars.Engine\AlchemyStars.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\AlchemyStarsIcon.png" />
    <AvaloniaResource Include="Assets\AppleBlue\*.png" />
    <EmbeddedResource Include="..\..\..\..\docs\samples\ubuntu-yaru\theme.json" LogicalName="AlchemyStars.UbuntuYaruTheme.json" />
    <Content Include="..\..\..\..\docs\samples\ubuntu-yaru\theme.json;..\..\..\..\docs\samples\ubuntu-yaru\icons.zip;..\..\..\..\docs\samples\ubuntu-yaru\README.zh-CN.md" Link="Samples\Ubuntu-Yaru\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\blender\convert_cast.py" Link="Converters\convert_cast.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\third_party\cast\blender\io_scene_cast\*.py" Link="BlenderPlugin\io_scene_cast\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\third_party\cast\LICENSE" Link="BlenderPlugin\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\third_party\cast\blender\UPSTREAM.md" Link="BlenderPlugin\UPSTREAM.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\AlchemyStarsIcon.ico" />
    <Content Include="..\..\..\..\third_party\cast\maya\*.py">
      <Link>MayaPlugin\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\..\maya\export_cast_to_fbx.py">
      <Link>Converters\export_cast_to_fbx.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveDebugSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
